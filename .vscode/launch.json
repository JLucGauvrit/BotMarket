{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Pytest Current File",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}",
        "-v"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Pytest All Tests",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "args": [
        "pytest/",
        "-v",
        "--tb=short"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Pytest with Coverage",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "args": [
        "pytest/",
        "-v",
        "--cov=bot",
        "--cov-report=html"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
