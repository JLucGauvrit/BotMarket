{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run All Tests",
      "type": "shell",
      "command": "pytest",
      "args": [
        "pytest/",
        "-v",
        "--tb=short"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": {
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^([^:]*):([0-9]+):[0-9]+ - (error|warning): (.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        }
      }
    },
    {
      "label": "Run Tests with Coverage",
      "type": "shell",
      "command": "pytest",
      "args": [
        "pytest/",
        "-v",
        "--cov=bot",
        "--cov-report=html",
        "--cov-report=term"
      ],
      "group": {
        "kind": "test"
      },
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Run Single Test File",
      "type": "shell",
      "command": "pytest",
      "args": [
        "${relativeFile}",
        "-v"
      ],
      "group": {
        "kind": "test"
      }
    }
  ]
}
